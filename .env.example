# FitDesi environment. Copy to .env and adjust.
# Never commit real secrets.

APP_NAME=FitDesi
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# Local development uses SQLite when PostgreSQL is not installed.
# Production should use PostgreSQL:
# DATABASE_URL=postgresql+psycopg://fitdesi:fitdesi@localhost:5432/fitdesi
DATABASE_URL=sqlite:///./fitdesi.db

CORS_ORIGINS=*

# Optional admin created by the seed command. Leave blank to skip.
ADMIN_EMAIL=admin@fitdesi.local
ADMIN_PASSWORD=change-me-admin

# Optional demo user. Created only when SEED_DEMO=true.
SEED_DEMO=true
DEMO_EMAIL=demo@fitdesi.local
DEMO_PASSWORD=change-me-demo

# SMTP is optional. Without it, messages are written to the server log.
# Password-reset and verification tokens are returned by the API only when DEBUG=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@fitdesi.local

# AI providers. Leave blank to use the deterministic on-device-data fallback.
# The fallback never invents diary records and never pretends to recognise a photo.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# USDA FoodData Central importer. A DEMO_KEY is rate limited.
USDA_API_KEY=

# Payments are not charged until a provider and merchant account exist.
PAYMENT_PROVIDER=none
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Object storage. local stores files under backend/storage.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=

# Mobile app points at this URL. Android emulator uses 10.0.2.2.
PUBLIC_BASE_URL=http://127.0.0.1:8000
