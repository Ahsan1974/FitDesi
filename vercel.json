{
  "functions": {
    "main.py": {
      "maxDuration": 60,
      "includeFiles": "backend/fitdesi.db",
      "excludeFiles": "public/fitdesi.apk"
    }
  },
  "headers": [
    {
      "source": "/fitdesi.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"fitdesi.apk\""
        }
      ]
    }
  ]
}
